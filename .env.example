# Azure Database for PostgreSQL Flexible Server. Copy the connection string
# from the portal (Settings → Connect) and put the password in it. TLS is
# required and verified either way, so sslmode is optional here.
#   postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/DB
# On General Purpose tier and above, enable PgBouncer and use port 6432.
#
# Optional locally: if this is unset, the app reads the same PGHOST / PGUSER /
# PGPASSWORD / PGDATABASE / PGPORT variables psql does, so a shell already set
# up for psql needs nothing more. Vercel uses the single variable below.
DATABASE_URL=
# Optional. Serverless functions each keep a small pool; raise only if the
# Azure "active connections" metric says there is room.
DATABASE_POOL_MAX=5

# Azure Blob Storage. Storage account → Security + networking → Access keys →
# "Connection string". Needs the account key: the conversation export signs
# short-lived SAS URLs with it. Containers `raw-audio` and `story-videos` must
# exist and stay private.
AZURE_STORAGE_CONNECTION_STRING=

# Better Auth's signing secret — sessions and password-reset tokens depend on
# it, so changing it signs everyone out. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Resend — use a sender on a verified domain for password-reset emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OpenAI — needs Realtime API access
OPENAI_API_KEY=

# SeeGen API key. Server-side only; create it at https://seegen.ai/account
SEEGEN_API_KEY=
# Optional overrides. Mini is the lowest-cost Seedance 2.0 tier.
SEEGEN_API_BASE_URL=https://seegen.ai/api/v1
SEEGEN_MODEL=sd2-mini
SEEGEN_OUTPUT_RESOLUTION=480p

# Encrypts recordings, transcripts, and private AI memory at rest (AES-256-GCM).
# Generate with:
#   openssl rand -base64 32
# Losing this key makes stored recordings and transcripts unreadable — back
# it up.
AUDIO_ENCRYPTION_KEY=

# Base URL of this app (used in authentication email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the scheduled cleanup in vercel.json. Any long random
# string; Vercel Cron sends it as a bearer token.
CRON_SECRET=

# Optional hosted video shown in the landing-page demo frame
NEXT_PUBLIC_DEMO_VIDEO_URL=
