# Supabase — create a project at https://supabase.com, then Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — use a sender on a verified domain for family invitations
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OpenAI — needs Realtime API access
OPENAI_API_KEY=

# SeeGen API key. Server-side only; create it at https://seegen.ai/account
SEEGEN_API_KEY=
# Optional overrides. Mini is the lowest-cost Seedance 2.0 tier.
SEEGEN_API_BASE_URL=https://seegen.ai/api/v1
SEEGEN_MODEL=sd2-mini
SEEGEN_OUTPUT_RESOLUTION=480p

# Encrypts recordings, transcripts, and private AI memory at rest (AES-256-GCM).
# Generate with:
#   openssl rand -base64 32
# Losing this key makes stored recordings and transcripts unreadable — back
# it up.
AUDIO_ENCRYPTION_KEY=

# Base URL of this app (used in authentication email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the scheduled cleanup in vercel.json. Any long random
# string; Vercel Cron sends it as a bearer token.
CRON_SECRET=

# Optional hosted video shown in the landing-page demo frame
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Wix CMS — read-only API exposed at /api/wix-cms
# Create an API key in Wix with the narrowest site access and "Read Data Items"
# permission. The collection ID is the developer-facing ID, not its display name.
WIX_API_KEY=
WIX_SITE_ID=
WIX_CMS_COLLECTION_ID=
# Separate secret required by clients calling this app's Wix CMS endpoint.
# Generate with: openssl rand -hex 32
WIX_CMS_READ_TOKEN=
