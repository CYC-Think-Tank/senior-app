# Supabase — create a project at https://supabase.com, then Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — use a sender on a verified domain for family invitations
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OpenAI — needs Realtime API access
OPENAI_API_KEY=

# Base URL of this app (used in authentication email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the scheduled cleanup in vercel.json. Any long random
# string; Vercel Cron sends it as a bearer token.
CRON_SECRET=
